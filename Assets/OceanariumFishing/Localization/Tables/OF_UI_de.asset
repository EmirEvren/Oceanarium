  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "Eine kleine Insel. Ein R\xFCckzugsort zum Gestalten."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Insel erkunden
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: Einstellungen und Sprache
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: "ASTRA 0.1 / Vorschau der Heimatinsel\nSolo-Erkundung \u2022 Fortschritt
      wird nicht gespeichert"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: HEIMATRIFF
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: "Erkunde die H\xFCtte, hole eine Angel am Steg und entdecke deinen
      zuk\xFCnftigen Aquariengarten."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: Startangel eingesammelt. Erkunde dein Inselrefugium.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD Bewegen \xB7 SHIFT Sprinten \xB7 Rechte Maustaste halten Kamera
      \xB7 E Interagieren \xB7 ESC Einstellungen"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: "Schlie\xDFen"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "Zur\xFCck zum Hauptmen\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: Kameraempfindlichkeit
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "Sprach\xE4nderungen gelten sofort. Deine Auswahl wird gespeichert."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "KOMMT SP\xC4TER"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Diese Szene ist f\xFCr einen sp\xE4teren Meilenstein reserviert.
      Hier gibt es noch keine Spielinhalte."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] H\xFCtte ansehen"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Vorratskiste ansehen'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: '[E] Startangel nehmen'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: '[E] Aquariengarten entdecken'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Deine H\xFCtte als Riffh\xFCter. Innenr\xE4ume kommen in einem
      sp\xE4teren Meilenstein."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Eine gemeinsame Vorratskiste. Inventar und dauerhafte Lagerung
      folgen sp\xE4ter."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: Deine erste Angel! Auswerfen und Angeln folgen im Angel-Meilenstein.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Du hast schon eine Angel. Diese sind f\xFCr deine zuk\xFCnftige
      Crew reserviert."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "Der Platz f\xFCr deinen zuk\xFCnftigen Aquariengarten. Bauen wird
      sp\xE4ter hinzugef\xFCgt."
    m_Metadata:
      m_Items: []
