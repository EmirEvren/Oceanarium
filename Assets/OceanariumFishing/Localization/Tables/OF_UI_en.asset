  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: A small island. A sanctuary to grow.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Begin island exploration
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: Settings & language
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: 'ASTRA 0.4 / Cozy fishing & collection

      Catches, journal and
      preferences are saved'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: HOME REEF
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: Explore your island. Collect a rod at the pier, then cast into the
      sea.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: "Your rod is ready. I: Inventory \xB7 J: Journal"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD Move \xB7 SHIFT Sprint \xB7 RMB Camera \xB7 E Interact \xB7
      I Inventory \xB7 J Journal \xB7 ESC Settings"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Close
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: Return to main menu
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: Camera sensitivity
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: Language changes apply immediately and your preference is saved.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: COMING LATER
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: This scene is reserved for a future milestone. No gameplay is implemented
      here.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: '[E] Inspect cabin'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Inspect supply chest'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: '[E] Collect starter rod'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: '[E] Discover sanctuary garden'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: Your reefkeeper cabin. Interiors will arrive in a later milestone.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: A shared supply chest. Inventory and persistent storage are planned
      for later.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: Your rod is equipped! Face the sea, hold LMB to charge and release
      to cast.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: You already have a rod. These are reserved for the rest of your
      future crew.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: A place for your future aquarium sanctuary. Construction comes in
      a later milestone.
    m_Metadata:
      m_Items: []
