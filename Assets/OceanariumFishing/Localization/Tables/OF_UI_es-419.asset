  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "Una peque\xF1a isla. Un refugio para hacer crecer."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Explorar la isla
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "Configuraci\xF3n e idioma"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: "ASTRA 0.1 / Vista previa de la isla principal\nExploraci\xF3n individual
      \u2022 No se guarda el progreso"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: ARRECIFE DEL HOGAR
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: "Explora la caba\xF1a, recoge una ca\xF1a en el muelle y descubre
      tu futuro jard\xEDn acu\xE1tico."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: "Recogiste la ca\xF1a inicial. Explora tu refugio en la isla."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD Moverse \xB7 SHIFT Correr \xB7 Mantener clic derecho C\xE1mara
      \xB7 E Interactuar \xB7 ESC Configuraci\xF3n"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Cerrar
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "Volver al men\xFA principal"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "Sensibilidad de la c\xE1mara"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: El idioma cambia de inmediato y se guarda tu preferencia.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "PR\xD3XIMAMENTE"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Esta escena est\xE1 reservada para una etapa futura. Todav\xEDa
      no incluye contenido jugable."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] Revisar la caba\xF1a"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Revisar el cofre de provisiones'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] Recoger la ca\xF1a inicial"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] Descubrir el jard\xEDn acu\xE1tico"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Tu caba\xF1a de guardi\xE1n del arrecife. Los interiores llegar\xE1n
      m\xE1s adelante."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Un cofre de provisiones compartido. El inventario y el almacenamiento
      permanente llegar\xE1n despu\xE9s."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: "\xA1Tu primera ca\xF1a! Lanzar la ca\xF1a y pescar se agregar\xE1n
      en la etapa de pesca."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Ya tienes una ca\xF1a. Estas est\xE1n reservadas para tu futura
      tripulaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "El lugar de tu futuro jard\xEDn acu\xE1tico. La construcci\xF3n
      llegar\xE1 m\xE1s adelante."
    m_Metadata:
      m_Items: []
