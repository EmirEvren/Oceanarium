  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "Une petite \xEEle. Un havre \xE0 faire grandir."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: "Explorer l\u2019\xEEle"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "Param\xE8tres et langue"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: "ASTRA 0.1 / Aper\xE7u de l\u2019\xEEle principale\nExploration
      solo \u2022 Progression non sauvegard\xE9e"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: "LE R\xC9CIF DU FOYER"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: "Explorez la cabane, prenez une canne sur le ponton et d\xE9couvrez
      votre futur jardin aquatique."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: "Canne de d\xE9part r\xE9cup\xE9r\xE9e. Explorez votre havre insulaire."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD D\xE9placement \xB7 SHIFT Course \xB7 Clic droit maintenu
      Cam\xE9ra \xB7 E Interagir \xB7 ESC Param\xE8tres"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Fermer
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: Retour au menu principal
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "Sensibilit\xE9 de la cam\xE9ra"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "La langue change imm\xE9diatement et votre pr\xE9f\xE9rence est
      enregistr\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "\xC0 VENIR"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Cette sc\xE8ne est r\xE9serv\xE9e \xE0 une \xE9tape future. Aucun
      contenu jouable pour le moment."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: '[E] Examiner la cabane'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Examiner le coffre de provisions'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] Prendre la canne de d\xE9part"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] D\xE9couvrir le jardin aquatique"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Votre cabane de gardien du r\xE9cif. L\u2019int\xE9rieur sera ajout\xE9
      plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Un coffre de provisions partag\xE9. L\u2019inventaire et le stockage
      persistant arriveront plus tard."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: "Votre premi\xE8re canne ! Le lancer et la p\xEAche seront ajout\xE9s
      \xE0 l\u2019\xE9tape d\xE9di\xE9e."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Vous avez d\xE9j\xE0 une canne. Celles-ci sont r\xE9serv\xE9es
      \xE0 votre futur \xE9quipage."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "L\u2019emplacement de votre futur jardin aquatique. La construction
      sera ajout\xE9e plus tard."
    m_Metadata:
      m_Items: []
