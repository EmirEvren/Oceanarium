  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: Una piccola isola. Un rifugio da far crescere.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: "Esplora l\u2019isola"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: Impostazioni e lingua
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: LA BARRIERA DI CASA
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Chiudi
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: Torna al menu principale
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "Sensibilit\xE0 della telecamera"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: La lingua cambia subito e la preferenza viene salvata.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: IN ARRIVO
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Questa scena \xE8 riservata a una fase futura. Non contiene ancora
      attivit\xE0 giocabili."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: '[E] Esamina la capanna'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Esamina la cassa delle provviste'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: '[E] Prendi la canna iniziale'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: '[E] Scopri il giardino acquatico'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "La tua capanna del custode della barriera. Gli interni arriveranno
      pi\xF9 avanti."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: Una cassa di provviste condivisa. Inventario e deposito persistente
      arriveranno in seguito.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Hai gi\xE0 una canna. Queste sono riservate al tuo futuro equipaggio."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "Il luogo del tuo futuro giardino acquatico. La costruzione arriver\xE0
      pi\xF9 avanti."
    m_Metadata:
      m_Items: []
