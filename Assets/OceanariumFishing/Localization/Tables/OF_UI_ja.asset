    m_Localized: "\u5171\u6709\u306E\u7269\u8CC7\u7BB1\u3067\u3059\u3002\u6301\u3061\u7269\u3068\u6C38\u7D9A\u7684\u306A\u4FDD\u7BA1\u6A5F\u80FD\u306F\u4ECA\u5F8C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
