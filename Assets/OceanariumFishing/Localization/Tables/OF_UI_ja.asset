    m_Localized: "ASTRA 0.1 / \u30DB\u30FC\u30E0\u30A2\u30A4\u30E9\u30F3\u30C9 \u30D7\u30EC\u30D3\u30E5\u30FC\n\u30BD\u30ED\u63A2\u7D22
