      m_Items: []
  - m_Id: 11710922773
    m_Localized: "\u672A\u6765\u306E\u6C34\u65CF\u5EAD\u5712\u306B\u306A\u308B\u5834\u6240\u3067\u3059\u3002\u5EFA\u7BC9\u6A5F\u80FD\u306F\u4ECA\u5F8C\u8FFD\u52A0\u3055\u308C\u307E\u3059\u3002"
