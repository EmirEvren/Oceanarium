  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "\uC791\uC740 \uC12C, \uD568\uAED8 \uAC00\uAFD4 \uAC08 \uC548\uC2DD\uCC98."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: "\uC12C \uD0D0\uD5D8 \uC2DC\uC791"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "\uC124\uC815 \uBC0F \uC5B8\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: "\uC6B0\uB9AC \uC9D1 \uC0B0\uD638\uCD08"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: "\uB2EB\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "\uBA54\uC778 \uBA54\uB274\uB85C \uB3CC\uC544\uAC00\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "\uCE74\uBA54\uB77C \uAC10\uB3C4"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "\uC5B8\uC5B4 \uBCC0\uACBD\uC740 \uC989\uC2DC \uC801\uC6A9\uB418\uBA70
      \uC120\uD0DD\uD55C \uC5B8\uC5B4\uAC00 \uC800\uC7A5\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "\uCD94\uD6C4 \uACF5\uAC1C"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "\uC774 \uC7A5\uBA74\uC740 \uD5A5\uD6C4 \uAC1C\uBC1C \uB2E8\uACC4\uB97C
      \uC704\uD574 \uB9C8\uB828\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uC544\uC9C1 \uD50C\uB808\uC774\uD560
      \uCF58\uD150\uCE20\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] \uC624\uB450\uB9C9 \uC0B4\uD3B4\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: "[E] \uBCF4\uAE09\uD488 \uC0C1\uC790 \uC0B4\uD3B4\uBCF4\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] \uCCAB \uB09A\uC2EF\uB300 \uBC1B\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] \uC218\uC871\uAD00 \uC815\uC6D0 \uCC3E\uAE30"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "\uC0B0\uD638\uCD08\uB97C \uC9C0\uD0A4\uB294 \uB2F9\uC2E0\uC758
      \uC624\uB450\uB9C9\uC785\uB2C8\uB2E4. \uB0B4\uBD80 \uACF5\uAC04\uC740 \uCD94\uD6C4
      \uCD94\uAC00\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "\uACF5\uC6A9 \uBCF4\uAE09\uD488 \uC0C1\uC790\uC785\uB2C8\uB2E4.
      \uC18C\uC9C0\uD488\uACFC \uC601\uAD6C \uBCF4\uAD00 \uAE30\uB2A5\uC740 \uCD94\uD6C4
      \uCD94\uAC00\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "\uC774\uBBF8 \uB09A\uC2EF\uB300\uAC00 \uC788\uC2B5\uB2C8\uB2E4.
      \uB098\uBA38\uC9C0\uB294 \uBBF8\uB798\uC758 \uB3D9\uB8CC\uB4E4\uC744 \uC704\uD55C
      \uAC83\uC785\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "\uBBF8\uB798\uC758 \uC218\uC871\uAD00 \uC815\uC6D0\uC774 \uB420
      \uACF3\uC785\uB2C8\uB2E4. \uAC74\uC124 \uAE30\uB2A5\uC740 \uCD94\uD6C4 \uCD94\uAC00\uB429\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
