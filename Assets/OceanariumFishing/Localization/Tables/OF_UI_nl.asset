  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: Een klein eiland. Een toevluchtsoord om te laten groeien.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Verken het eiland
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: Instellingen en taal
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: THUISRIF
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Sluiten
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: Terug naar het hoofdmenu
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: Cameragevoeligheid
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: De taal verandert direct en je voorkeur wordt opgeslagen.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: KOMT LATER
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Deze sc\xE8ne is gereserveerd voor een toekomstige mijlpaal. Er
      is hier nog geen speelbare inhoud."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: '[E] Hut bekijken'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: '[E] Voorraadkist bekijken'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: '[E] Starthengel pakken'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: '[E] Aquariumtuin ontdekken'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: Je hut als rifwachter. Het interieur wordt later toegevoegd.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: Een gedeelde voorraadkist. Inventaris en blijvende opslag volgen
      later.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: Je hebt al een hengel. Deze zijn gereserveerd voor je toekomstige
      bemanning.
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: De plek voor je toekomstige aquariumtuin. Bouwen wordt later toegevoegd.
    m_Metadata:
      m_Items: []
