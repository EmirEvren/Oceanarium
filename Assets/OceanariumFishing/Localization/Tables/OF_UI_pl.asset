  m_SharedData: {fileID: 11400000, guid: 73e6651523f2dd64a9d5e4d626dbab22, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "Ma\u0142a wyspa. Oaza, kt\xF3r\u0105 mo\u017Cesz rozwija\u0107."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Rozpocznij odkrywanie wyspy
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "Ustawienia i j\u0119zyk"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: "ASTRA 0.1 / Podgl\u0105d wyspy domowej\nEksploracja solo \u2022
      Post\u0119py nie s\u0105 zapisywane"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: DOMOWA RAFA
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: "Zbadaj chatk\u0119, we\u017A w\u0119dk\u0119 z pomostu i odkryj
      miejsce na sw\xF3j przysz\u0142y ogr\xF3d akwariowy."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: "Pocz\u0105tkowa w\u0119dka zebrana. Odkrywaj swoj\u0105 wyspiarsk\u0105
      oaz\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD Ruch \xB7 SHIFT Sprint \xB7 Przytrzymaj prawy przycisk myszy
      Kamera \xB7 E Interakcja \xB7 ESC Ustawienia"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Zamknij
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "Wr\xF3\u0107 do menu g\u0142\xF3wnego"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "Czu\u0142o\u015B\u0107 kamery"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "J\u0119zyk zmienia si\u0119 od razu, a Tw\xF3j wyb\xF3r zostaje
      zapisany."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "WKR\xD3TCE"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Ta scena jest przeznaczona na przysz\u0142y etap. Nie ma tu jeszcze
      rozgrywki."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] Obejrzyj chatk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: "[E] Obejrzyj skrzyni\u0119 z zapasami"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] We\u017A pocz\u0105tkow\u0105 w\u0119dk\u0119"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] Odkryj ogr\xF3d akwariowy"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Twoja chatka opiekuna rafy. Wn\u0119trza pojawi\u0105 si\u0119
      na p\xF3\u017Aniejszym etapie."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Wsp\xF3lna skrzynia z zapasami. Ekwipunek i trwa\u0142y magazyn
      pojawi\u0105 si\u0119 p\xF3\u017Aniej."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: "Twoja pierwsza w\u0119dka! Zarzucanie i \u0142owienie pojawi\u0105
      si\u0119 na etapie w\u0119dkowania."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Masz ju\u017C w\u0119dk\u0119. Te s\u0105 przeznaczone dla Twojej
      przysz\u0142ej za\u0142ogi."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "Miejsce na Tw\xF3j przysz\u0142y ogr\xF3d akwariowy. Budowanie
      pojawi si\u0119 p\xF3\u017Aniej."
    m_Metadata:
      m_Items: []
