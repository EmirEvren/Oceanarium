  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "Uma pequena ilha. Um ref\xFAgio para cultivar."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: Explorar a ilha
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "Configura\xE7\xF5es e idioma"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: RECIFE DO LAR
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Fechar
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: Voltar ao menu principal
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "Sensibilidade da c\xE2mera"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "O idioma muda imediatamente e sua prefer\xEAncia \xE9 salva."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: EM BREVE
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Esta cena est\xE1 reservada para uma etapa futura. Ainda n\xE3o
      h\xE1 conte\xFAdo jog\xE1vel aqui."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: '[E] Examinar a cabana'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: "[E] Examinar o ba\xFA de suprimentos"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: '[E] Pegar a vara inicial'
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] Descobrir o jardim aqu\xE1tico"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Sua cabana de guardi\xE3o do recife. Os interiores ser\xE3o adicionados
      mais tarde."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Um ba\xFA de suprimentos compartilhado. O invent\xE1rio e o armazenamento
      permanente chegar\xE3o depois."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Voc\xEA j\xE1 tem uma vara. Estas est\xE3o reservadas para sua
      futura tripula\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "O local do seu futuro jardim aqu\xE1tico. A constru\xE7\xE3o ser\xE1
      adicionada mais tarde."
    m_Metadata:
      m_Items: []
