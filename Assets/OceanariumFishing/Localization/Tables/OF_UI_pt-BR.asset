    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451687
    m_Localized: Join or host a Steam lobby first.
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451688
    m_Localized: The host left. Your island is now offline.
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451689
    m_Localized: Connection lost. You can rejoin to restore your saved character.
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451690
