    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451665
    m_Localized: Refresh lobbies
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451666
    m_Localized: You can also accept an invitation in the Steam overlay.
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451667
    m_Localized: 'Co-op foundation: guests can explore. World interactions are currently
      controlled by the host.'
    m_Metadata:
      m_Items: []
  - m_Id: 1095555255451668
    m_Localized: Welcome to your island.
