  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "K\xFC\xE7\xFCk bir ada. B\xFCy\xFCtece\u011Fin huzurlu bir yuva."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: "Aday\u0131 ke\u015Ffetmeye ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: Ayarlar ve dil
    m_Metadata:
      m_Items: []
  - m_Id: 11710922754
    m_Localized: "ASTRA 0.1 / Ana ada \xF6n izlemesi\nTek ki\u015Filik ke\u015Fif
      \u2022 \u0130lerleme kaydedilmez"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: "YUVANIN RES\u0130F\u0130"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922756
    m_Localized: "Kul\xFCbeyi ke\u015Ffet, iskeleden bir olta al ve gelecekteki akvaryum
      bah\xE7eni bul."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922757
    m_Localized: "Ba\u015Flang\u0131\xE7 oltas\u0131 al\u0131nd\u0131. Adandaki huzurlu
      yuvan\u0131 ke\u015Ffet."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922758
    m_Localized: "WASD Hareket \xB7 SHIFT Ko\u015F \xB7 Sa\u011F fareyi bas\u0131l\u0131
      tut Kamera \xB7 E Etkile\u015Fim \xB7 ESC Ayarlar"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "Ana men\xFCye d\xF6n"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: Kamera hassasiyeti
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "Dil de\u011Fi\u015Fiklikleri hemen uygulan\u0131r ve tercihin kaydedilir."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "\u0130LER\u0130DE GELECEK"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "Bu sahne sonraki bir a\u015Fama i\xE7in ayr\u0131ld\u0131. Burada
      hen\xFCz oynan\u0131\u015F yok."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] Kul\xFCbeyi incele"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: "[E] Erzak sand\u0131\u011F\u0131n\u0131 incele"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] Ba\u015Flang\u0131\xE7 oltas\u0131n\u0131 al"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] Akvaryum bah\xE7esini ke\u015Ffet"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "Resif bek\xE7isinin kul\xFCbesi. \u0130\xE7 mek\xE2n sonraki bir
      a\u015Famada eklenecek."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "Ortak erzak sand\u0131\u011F\u0131. Envanter ve kal\u0131c\u0131
      depolama daha sonra eklenecek."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922771
    m_Localized: "\u0130lk oltan! Olta atma ve bal\u0131k tutma, bal\u0131k\xE7\u0131l\u0131k
      a\u015Famas\u0131nda eklenecek."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "Zaten bir oltan var. Bunlar gelecekteki ekip arkada\u015Flar\u0131n
      i\xE7in ayr\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "Gelecekteki akvaryum bah\xE7enin yeri. \u0130n\u015Fa sistemi sonraki
      bir a\u015Famada eklenecek."
    m_Metadata:
      m_Items: []
