    m_Localized: "D\xFCz ti\u015F\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598497
    m_Localized: "\xC7izgili ti\u015F\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598498
    m_Localized: Rahat kazak
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598499
    m_Localized: "Bal\u0131k\xE7\u0131 g\xF6mle\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598500
    m_Localized: "Kap\xFC\u015Fonlu \xFCst"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598501
    m_Localized: "G\xFCnl\xFCk ceket"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598503
    m_Localized: "\u015Eort"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598504
    m_Localized: "Kot \u015Fort"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598505
    m_Localized: Pantolon
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598506
    m_Localized: Kargo pantolon
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598507
    m_Localized: "K\u0131sa etek"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598508
    m_Localized: Uzun etek
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598510
    m_Localized: "Spor ayakkab\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598511
    m_Localized: "K\u0131sa bot"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598512
    m_Localized: "Bal\u0131k\xE7\u0131 \xE7izmesi"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598513
    m_Localized: Sandalet
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598514
    m_Localized: "Rahat ayakkab\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598516
    m_Localized: Kep
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598517
    m_Localized: "Has\u0131r \u015Fapka"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598518
    m_Localized: "Bal\u0131k\xE7\u0131 \u015Fapkas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598519
    m_Localized: Bere
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598520
    m_Localized: "Kova \u015Fapka"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598522
    m_Localized: "Yuvarlak g\xF6zl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598523
    m_Localized: "Kare g\xF6zl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598524
    m_Localized: "G\xFCne\u015F g\xF6zl\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598526
    m_Localized: "S\u0131rt \xE7antas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598527
    m_Localized: "\xC7apraz \xE7anta"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598528
    m_Localized: Kolye
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598529
    m_Localized: Bileklik
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598531
    m_Localized: "Deniz k\xF6p\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598532
    m_Localized: Mercan
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598533
    m_Localized: Krem
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598534
    m_Localized: Lacivert
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598535
    m_Localized: Lavanta
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598536
    m_Localized: Hardal
    m_Metadata:
      m_Items: []
  - m_Id: 288396518260736
    m_Localized: "Resif bek\xE7isinin oltas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398080
    m_Localized: "Biraz sab\u0131r. Kocaman bir okyanus."
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398081
    m_Localized: "At\u0131\u015F g\xFCc\xFCn\xFC ayarla"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398082
    m_Localized: "Denize do\u011Fru!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398083
    m_Localized: "\u015Eamand\u0131ray\u0131 izle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398084
    m_Localized: BALIK VURDU!
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398085
    m_Localized: "M\xDCKEMMEL!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398086
    m_Localized: "HAR\u0130KA!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398087
    m_Localized: "G\xDCZEL!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398088
    m_Localized: "Son anda yakalad\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398089
    m_Localized: "A\xE7\u0131k suya ni\u015Fan al"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398090
    m_Localized: "\u015Eu anda burada bal\u0131k yok"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398091
    m_Localized: "Kancalama f\u0131rsat\u0131 ka\xE7t\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398092
    m_Localized: "Bal\u0131k ka\xE7t\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592384
    m_Localized: "Okyanustan yeni bir hik\xE2ye"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592385
    m_Localized: "Bal\u0131k kaydedildi"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592386
    m_Localized: Yeniden maviliklere
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592387
    m_Localized: "Kaydedilemedi. Ayr\u0131lmadan tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592388
    m_Localized: Kontrol sende
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592389
    m_Localized: Yakalama ilerlemesi
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592390
    m_Localized: Misina gerilimi
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592391
    m_Localized: "Bal\u0131\u011F\u0131n dayan\u0131kl\u0131l\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592392
    m_Localized: "Bal\u0131\u011F\u0131n y\xF6n\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592393
    m_Localized: "KOMBO \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592394
    m_Localized: "At\u0131\u015F g\xFCc\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592395
    m_Localized: "A\u011F\u0131rl\u0131k: {0:0.00} kg"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592396
    m_Localized: 'Uzunluk: {0:0.0} cm'
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592397
    m_Localized: "\u0130ri ve \xF6zel \xF6rnek"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592398
    m_Localized: "Sa\u011Fl\u0131kl\u0131 \xF6rnek"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592399
    m_Localized: "YEN\u0130 K\u0130\u015E\u0130SEL REKOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592400
    m_Localized: SAKLA
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592401
    m_Localized: SERBEST BIRAK
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592402
    m_Localized: "Sol fareyi bas\u0131l\u0131 tut: g\xFC\xE7 \xB7 B\u0131rak: at\u0131\u015F
      \xB7 Sa\u011F fare: ni\u015Fan"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592403
    m_Localized: "Q: iptal \xB7 \u015Eamand\u0131ray\u0131 izlemeye devam et"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592404
    m_Localized: "Kancalamak i\xE7in \u015Fimdi sol t\u0131kla!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592405
    m_Localized: "Sol fare: sar \xB7 B\u0131rak: gerilimi d\xFC\u015F\xFCr\nFareyi
      \xE7eki\u015Fin tersine g\xF6t\xFCr \xB7 Q: iptal"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592406
    m_Localized: "Palya\xE7o bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592407
    m_Localized: "Mavi cerrah bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592408
    m_Localized: Sardalya
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592409
    m_Localized: Uskumru
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592410
    m_Localized: "K\u0131rm\u0131z\u0131 mercan"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592411
    m_Localized: "\xC7ipura"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592412
    m_Localized: "Balon bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592413
    m_Localized: "Alt\u0131n istavrit"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592414
    m_Localized: "Yayg\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592415
    m_Localized: Az rastlanan
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592416
    m_Localized: Nadir
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592417
    m_Localized: "Destans\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592418
    m_Localized: Efsanevi
    m_Metadata:
      m_Items: []
  - m_Id: 289997865779200
    m_Localized: "At\u0131\u015F mesafesi"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333632
    m_Localized: "\u0130sabet"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333633
    m_Localized: "Olta g\xFCc\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333634
    m_Localized: "Misina dayan\u0131kl\u0131l\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333635
    m_Localized: "Sarma h\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333636
    m_Localized: Kontrol
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333637
    m_Localized: "Dayan\u0131kl\u0131l\u0131k"
    m_Metadata:
      m_Items: []
