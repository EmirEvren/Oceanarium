    m_Localized: "D\xFCz ti\u015F\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598497
    m_Localized: "\xC7izgili ti\u015F\xF6rt"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598498
    m_Localized: Rahat kazak
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598499
    m_Localized: "Bal\u0131k\xE7\u0131 g\xF6mle\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598500
    m_Localized: "Kap\xFC\u015Fonlu \xFCst"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598501
    m_Localized: "G\xFCnl\xFCk ceket"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598503
    m_Localized: "\u015Eort"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598504
    m_Localized: "Kot \u015Fort"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598505
    m_Localized: Pantolon
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598506
    m_Localized: Kargo pantolon
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598507
    m_Localized: "K\u0131sa etek"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598508
    m_Localized: Uzun etek
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598510
    m_Localized: "Spor ayakkab\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598511
    m_Localized: "K\u0131sa bot"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598512
    m_Localized: "Bal\u0131k\xE7\u0131 \xE7izmesi"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598513
    m_Localized: Sandalet
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598514
    m_Localized: "Rahat ayakkab\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598516
    m_Localized: Kep
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598517
    m_Localized: "Has\u0131r \u015Fapka"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598518
    m_Localized: "Bal\u0131k\xE7\u0131 \u015Fapkas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598519
    m_Localized: Bere
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598520
    m_Localized: "Kova \u015Fapka"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598522
    m_Localized: "Yuvarlak g\xF6zl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598523
    m_Localized: "Kare g\xF6zl\xFCk"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598524
    m_Localized: "G\xFCne\u015F g\xF6zl\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598526
    m_Localized: "S\u0131rt \xE7antas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598527
    m_Localized: "\xC7apraz \xE7anta"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598528
    m_Localized: Kolye
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598529
    m_Localized: Bileklik
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598531
    m_Localized: "Deniz k\xF6p\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598532
    m_Localized: Mercan
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598533
    m_Localized: Krem
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598534
    m_Localized: Lacivert
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598535
    m_Localized: Lavanta
    m_Metadata:
      m_Items: []
  - m_Id: 281666090598536
    m_Localized: Hardal
    m_Metadata:
      m_Items: []
  - m_Id: 288396518260736
    m_Localized: "Resif bek\xE7isinin oltas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398080
    m_Localized: "Biraz sab\u0131r. Kocaman bir okyanus."
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398081
    m_Localized: "At\u0131\u015F g\xFCc\xFCn\xFC ayarla"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398082
    m_Localized: "Denize do\u011Fru!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398083
    m_Localized: "\u015Eamand\u0131ray\u0131 izle\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398084
    m_Localized: BALIK VURDU!
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398085
    m_Localized: "M\xDCKEMMEL!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398086
    m_Localized: "HAR\u0130KA!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398087
    m_Localized: "G\xDCZEL!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398088
    m_Localized: "Son anda yakalad\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398089
    m_Localized: "A\xE7\u0131k suya ni\u015Fan al"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398090
    m_Localized: "\u015Eu anda burada bal\u0131k yok"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398091
    m_Localized: "Kancalama f\u0131rsat\u0131 ka\xE7t\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396564398092
    m_Localized: "Bal\u0131k ka\xE7t\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592384
    m_Localized: "Okyanustan yeni bir hik\xE2ye"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592385
    m_Localized: "Bal\u0131k kaydedildi"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592386
    m_Localized: Yeniden maviliklere
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592387
    m_Localized: "Kaydedilemedi. Ayr\u0131lmadan tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592388
    m_Localized: Kontrol sende
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592389
    m_Localized: Yakalama ilerlemesi
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592390
    m_Localized: Misina gerilimi
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592391
    m_Localized: "Bal\u0131\u011F\u0131n dayan\u0131kl\u0131l\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592392
    m_Localized: "Bal\u0131\u011F\u0131n y\xF6n\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592393
    m_Localized: "KOMBO \xD7{0}"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592394
    m_Localized: "At\u0131\u015F g\xFCc\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592395
    m_Localized: "A\u011F\u0131rl\u0131k: {0:0.00} kg"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592396
    m_Localized: 'Uzunluk: {0:0.0} cm'
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592397
    m_Localized: "\u0130ri ve \xF6zel \xF6rnek"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592398
    m_Localized: "Sa\u011Fl\u0131kl\u0131 \xF6rnek"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592399
    m_Localized: "YEN\u0130 K\u0130\u015E\u0130SEL REKOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592400
    m_Localized: SAKLA
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592401
    m_Localized: SERBEST BIRAK
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592402
    m_Localized: "Sol fareyi bas\u0131l\u0131 tut: g\xFC\xE7 \xB7 B\u0131rak: at\u0131\u015F
      \xB7 Sa\u011F fare: ni\u015Fan"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592403
    m_Localized: "Q: iptal \xB7 \u015Eamand\u0131ray\u0131 izlemeye devam et"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592404
    m_Localized: "Kancalamak i\xE7in \u015Fimdi sol t\u0131kla!"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592405
    m_Localized: "Sol fare: sar \xB7 B\u0131rak: gerilimi d\xFC\u015F\xFCr\nFareyi
      \xE7eki\u015Fin tersine g\xF6t\xFCr \xB7 Q: iptal"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592406
    m_Localized: "Palya\xE7o bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592407
    m_Localized: "Mavi cerrah bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592408
    m_Localized: Sardalya
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592409
    m_Localized: Uskumru
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592410
    m_Localized: "K\u0131rm\u0131z\u0131 mercan"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592411
    m_Localized: "\xC7ipura"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592412
    m_Localized: "Balon bal\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592413
    m_Localized: "Alt\u0131n istavrit"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592414
    m_Localized: "Yayg\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592415
    m_Localized: Az rastlanan
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592416
    m_Localized: Nadir
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592417
    m_Localized: "Destans\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 288396568592418
    m_Localized: Efsanevi
    m_Metadata:
      m_Items: []
  - m_Id: 289997865779200
    m_Localized: "At\u0131\u015F mesafesi"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333632
    m_Localized: "\u0130sabet"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333633
    m_Localized: "Olta g\xFCc\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333634
    m_Localized: "Misina dayan\u0131kl\u0131l\u0131\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333635
    m_Localized: "Sarma h\u0131z\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333636
    m_Localized: Kontrol
    m_Metadata:
      m_Items: []
  - m_Id: 289997899333637
    m_Localized: "Dayan\u0131kl\u0131l\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 317058652127232
    m_Localized: "Bal\u0131k Envanteri"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653184
    m_Localized: "Oceanarium G\xFCnl\xFC\u011F\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653185
    m_Localized: "Bal\u0131k\xE7\u0131l\u0131k rekorlar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653186
    m_Localized: "Bal\u0131klar"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653187
    m_Localized: "bal\u0131k saklan\u0131yor"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653188
    m_Localized: "S\u0131rala"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653189
    m_Localized: Tarih
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653190
    m_Localized: "A\u011F\u0131rl\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653191
    m_Localized: Nadirlik
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653192
    m_Localized: "T\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653193
    m_Localized: "T\xFCm\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653194
    m_Localized: Nadirlik
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653195
    m_Localized: Ada filtresi
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653196
    m_Localized: "Bal\u0131\u011F\u0131n kalitesi"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653197
    m_Localized: "Yakaland\u0131\u011F\u0131 yer"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653198
    m_Localized: Yakalanma tarihi
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653199
    m_Localized: "Tahmini de\u011Fer"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653200
    m_Localized: "Ki\u015Fisel rekor!"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653201
    m_Localized: "Koleksiyonun ilk bal\u0131\u011F\u0131n\u0131 bekliyor. Yakalad\u0131\u011F\u0131n
      bir bal\u0131\u011F\u0131 saklayarak ayr\u0131nt\u0131lar\u0131n\u0131 burada
      g\xF6rebilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653202
    m_Localized: "KE\u015EFED\u0130LEN BALIKLAR  {0} / {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653203
    m_Localized: "Ke\u015Ffedildi"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653204
    m_Localized: "Ke\u015Ffedilmedi"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653205
    m_Localized: Bilinmiyor
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653206
    m_Localized: "Okyanusun bir s\u0131rr\u0131. Bu t\xFCr\xFC yakalayarak hik\xE2yesini
      \xF6\u011Fren. Serbest b\u0131rakt\u0131\u011F\u0131n bal\u0131klar da say\u0131l\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653207
    m_Localized: "Ya\u015Fam alan\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653208
    m_Localized: "Ke\u015Ffedildi\u011Fi yer"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653209
    m_Localized: "Tercih etti\u011Fi hava"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653210
    m_Localized: Etkin saatler
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653211
    m_Localized: Yakalanan
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653212
    m_Localized: "En a\u011F\u0131r"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653213
    m_Localized: En uzun
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653214
    m_Localized: "\u0130lk ke\u015Fif"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653215
    m_Localized: "Toplam yakalanan bal\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653216
    m_Localized: "En \xE7ok yakalanan t\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653217
    m_Localized: "En nadir t\xFCr"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653218
    m_Localized: "Baz\u0131 eski yakalamalar\u0131n tarih veya adet bilgisi eksik.
      Mevcut rekorlar korundu."
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653219
    m_Localized: "Koleksiyon kayd\u0131 okunamad\u0131. Dosya korundu ve \xFCzerine
      yaz\u0131lmayacak."
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653220
    m_Localized: "I Envanter \xB7 J G\xFCnl\xFCk \xB7 ESC Kapat"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653221
    m_Localized: "\xD6nceki sayfa"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653222
    m_Localized: Sonraki sayfa
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653223
    m_Localized: "Bal\u0131k\xE7\u0131l\u0131k zorlu\u011Fu"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653224
    m_Localized: Rahat
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653225
    m_Localized: Normal
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653226
    m_Localized: Deneyimli
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653227
    m_Localized: "Sarmak i\xE7in sol fareyi bas\u0131l\u0131 tut. Gerilim y\xFCksekse
      b\u0131rak.\nFare y\xF6n\xFC iste\u011Fe ba\u011Fl\u0131d\u0131r.\nQ: iptal"
    m_Metadata:
      m_Items: []
  - m_Id: 317058706653228
    m_Localized: "! Y\xDCKSEK GER\u0130L\u0130M \u2014 Toparlanmak i\xE7in b\u0131rak"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041792
    m_Localized: Sakince sar. Vaktin var.
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041793
    m_Localized: "HAR\u0130KA TOPARLADIN!"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041794
    m_Localized: "\u0130LK ATI\u015EIN\n1. Sol fareyi bas\u0131l\u0131 tut, atmak
      i\xE7in b\u0131rak.\n2. Bal\u0131k vurunca t\u0131kla.\n3. Sarmak i\xE7in sol
      fareyi bas\u0131l\u0131 tut.\n4. Gerilim y\xFCkselince b\u0131rak.\n5. Bal\u0131\u011F\u0131n\u0131
      sakla veya serbest b\u0131rak."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041795
    m_Localized: "YEN\u0130 T\xDCR KE\u015EFED\u0130LD\u0130!"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041796
    m_Localized: "Oceanarium G\xFCnl\xFC\u011F\xFCne i\u015Flendi. Saklasan da serbest
      b\u0131raksan da ke\u015Ffin korunur."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041797
    m_Localized: Ana Ada
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041798
    m_Localized: "Kasaba Adas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041799
    m_Localized: "Ke\u015Fif Adas\u0131 01"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041800
    m_Localized: "Ke\u015Fif Adas\u0131 02"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041801
    m_Localized: "Ke\u015Fif Adas\u0131 03"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041802
    m_Localized: "S\u0131\u011F k\u0131y\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041803
    m_Localized: "S\u0131\u011F k\u0131y\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041804
    m_Localized: "Kayal\u0131k resif"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041805
    m_Localized: "Kayal\u0131k resif"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041806
    m_Localized: "\u0130skele sular\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041807
    m_Localized: "\u0130skele sular\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041808
    m_Localized: Derin su
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041809
    m_Localized: Derin su
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041810
    m_Localized: "A\xE7\u0131k"
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041811
    m_Localized: Bulutlu
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041812
    m_Localized: "Krem rengi bantlar\u0131yla resifin parlak k\xFC\xE7\xFCk sakini."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041813
    m_Localized: "Alt\u0131n renkli kuyru\u011Fuyla canl\u0131 mavi bir resif y\xFCz\xFCc\xFCs\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041814
    m_Localized: "K\u0131y\u0131 sular\u0131nda parlayan ince, g\xFCm\xFC\u015F renkli
      bir bal\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041815
    m_Localized: "Koyu dalgal\u0131 \xE7izgileri olan h\u0131zl\u0131 bir y\xFCz\xFCc\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041816
    m_Localized: "G\xFC\xE7l\xFC siluetli, s\u0131cak k\u0131rm\u0131z\u0131 renkli
      bir bal\u0131k."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041817
    m_Localized: "Alt\u0131n renkli ayr\u0131nt\u0131s\u0131 olan g\xFCm\xFC\u015F
      bir k\u0131y\u0131 bal\u0131\u011F\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041818
    m_Localized: "Minik y\xFCzge\xE7leriyle yuvarlak ve benekli bir resif ziyaret\xE7isi."
    m_Metadata:
      m_Items: []
  - m_Id: 317058715041819
    m_Localized: "Belirgin koyu bantlar\u0131 olan alt\u0131n renkli bir okyanus
      gezgini."
    m_Metadata:
      m_Items: []
  - m_Id: 751787644977152
    m_Localized: "Oceanarium \u2022 Ya\u015Fayan koleksiyon"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308800
    m_Localized: "Bal\u0131klar ve \xF6rnekler"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308801
    m_Localized: Dekorasyon
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308802
    m_Localized: "Resepsiyon ve ba\u011F\u0131\u015Flar"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308803
    m_Localized: Sikke
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308804
    m_Localized: "Pop\xFClerlik"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308805
    m_Localized: Tank
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308806
    m_Localized: "Bal\u0131k kapasitesi"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308807
    m_Localized: "Uyumlu \u2022 depoda"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308808
    m_Localized: Sergileniyor
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308809
    m_Localized: Depo
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308810
    m_Localized: "Bu bal\u0131\u011F\u0131 yerle\u015Ftir"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308811
    m_Localized: Depoya geri al
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308812
    m_Localized: "Bal\u0131\u011F\u0131n art\u0131k sergisinde y\xFCz\xFCyor."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308813
    m_Localized: "Ayn\u0131 bal\u0131k g\xFCvenle depoya d\xF6nd\xFC."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308814
    m_Localized: "Nadirlik ve kalite katk\u0131s\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308815
    m_Localized: "K\xFC\xE7\xFCk tank"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308816
    m_Localized: Orta tank
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308817
    m_Localized: "B\xFCy\xFCk tank"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308818
    m_Localized: Tropikal tuzlu su
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308819
    m_Localized: "Il\u0131man tuzlu su"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308820
    m_Localized: "Tatl\u0131 su"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308821
    m_Localized: Mercan Resifi
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308822
    m_Localized: "K\u0131y\u0131 S\xFCr\xFCs\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308823
    m_Localized: "Sakin Lag\xFCn"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308824
    m_Localized: Okyanus Galerisi
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308825
    m_Localized: "[E] Akvaryum tank\u0131n\u0131 y\xF6net"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308826
    m_Localized: "[E] Ba\u011F\u0131\u015Flar ve m\xFCze geli\u015Ftirmeleri"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308827
    m_Localized: "Bu bal\u0131k ba\u015Fka bir bak\u0131c\u0131ya ait."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308828
    m_Localized: "Bu tank\u0131 resepsiyondan a\xE7."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308829
    m_Localized: "Bu bal\u0131k zaten sergileniyor."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308830
    m_Localized: "Su habitat\u0131 uyumsuz"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308831
    m_Localized: "Bu bal\u0131\u011F\u0131n daha b\xFCy\xFCk bir tanka ihtiyac\u0131
      var."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308832
    m_Localized: Tank dolu
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308833
    m_Localized: "Kaydedilemedi. \xD6nceki durumun korundu."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308834
    m_Localized: "Sonraki av\u0131nda bir bal\u0131\u011F\u0131 sakla ve uyumlu tank\u0131
      se\xE7. Sergilenen bal\u0131klar\u0131n kimli\u011Fi ve sahipli\u011Fi korunur."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308835
    m_Localized: "K\xFC\xE7\xFCk bir resif, daha mutlu bir m\xFCze"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308836
    m_Localized: "Temel Dekorasyon Paketi d\xF6rt sergiye mercan, bah\xE7eye \xE7i\xE7ek
      ekler. Su kimyas\u0131n\u0131 de\u011Fi\u015Ftirmeden pop\xFClerli\u011Fi art\u0131r\u0131r.
      Resepsiyondan bir kez sat\u0131n al."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308837
    m_Localized: "B\xFCy\xFCk tanklar ve yeni m\xFCze kanatlar\u0131 sonraki a\u015Famalar
      i\xE7in ayr\u0131ld\u0131."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308838
    m_Localized: "M\xFCze geli\u015Ftirmeleri"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308839
    m_Localized: "A\u011F\u0131rlanan ziyaret\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308840
    m_Localized: "\u015Eu an burada"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308841
    m_Localized: "Bekleyen ba\u011F\u0131\u015Flar"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308842
    m_Localized: Toplam toplanan
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308843
    m_Localized: "Ba\u011F\u0131\u015Flar\u0131 topla"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308844
    m_Localized: "Ba\u011F\u0131\u015Flar c\xFCzdan\u0131na eklendi."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308845
    m_Localized: "Hen\xFCz toplanacak ba\u011F\u0131\u015F yok."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308846
    m_Localized: "Son ziyaret\xE7i ba\u011F\u0131\u015Flar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308847
    m_Localized: "Sat\u0131n al"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308848
    m_Localized: "Zaten a\xE7\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308849
    m_Localized: "Yeterli sikke yok. \xD6nce daha fazla ziyaret\xE7i a\u011F\u0131rla."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308850
    m_Localized: "\xD6nce sergilerin pop\xFClerli\u011Fini art\u0131r."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308851
    m_Localized: "Geli\u015Ftirme sat\u0131n al\u0131nd\u0131 ve kaydedildi."
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308852
    m_Localized: "Ne g\xFCzel bir bal\u0131k!"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308853
    m_Localized: "T\xFCr \xE7e\u015Fitlili\u011Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308854
    m_Localized: "Nadirlik ve bal\u0131k kalitesi"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308855
    m_Localized: "Tank \xE7e\u015Fitlili\u011Fi ve habitat"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308856
    m_Localized: "Dekorasyon ve geli\u015Ftirmeler"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308857
    m_Localized: Yeni Akvaryum
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308858
    m_Localized: "Yerel \u0130lgi Oda\u011F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308859
    m_Localized: "Pop\xFCler Akvaryum"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308860
    m_Localized: "Adan\u0131n G\xF6zdesi"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308861
    m_Localized: "Okyanus Harikas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308862
    m_Localized: "Ziyaret\xE7i Konforu"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308863
    m_Localized: "Akvaryum Tabelalar\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308864
    m_Localized: Temel Dekorasyon Paketi
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308865
    m_Localized: "Orta Tank Kilidini A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308866
    m_Localized: "Ek oturma alan\u0131 \u2022 ba\u011F\u0131\u015Flar +%20"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308867
    m_Localized: "Kar\u015F\u0131lama flamalar\u0131 \u2022 daha s\u0131k ziyaret\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308868
    m_Localized: "Mercanlar, \xE7i\xE7ekler ve pop\xFClerlik"
    m_Metadata:
      m_Items: []
  - m_Id: 751787695308869
    m_Localized: "Alt\u0131 bal\u0131k \u2022 en fazla 75 cm \u2022 15 pop\xFClerlik
      gerekir"
    m_Metadata:
      m_Items: []
