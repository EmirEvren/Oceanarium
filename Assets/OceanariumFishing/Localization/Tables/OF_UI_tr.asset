    m_Metadata:
      m_Items: []
  - m_Id: 845681065885712
    m_Localized: "Gull \xB7 20:00"
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885713
    m_Localized: Gull trades Monday and Friday nights, until 02:00. Season changes
      on day 1.
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885714
    m_Localized: Sleep until morning
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885715
    m_Localized: Rest at home until 08:00 tomorrow? Your belongings and quests are
      kept. No income is awarded for skipped time.
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885716
    m_Localized: Sleep until tomorrow
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885717
    m_Localized: Return to your cabin and finish your current activity first.
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885718
    m_Localized: The world could not be saved. Time was not advanced.
    m_Metadata:
      m_Items: []
  - m_Id: 845681065885719
    m_Localized: "D\xFCkkan kapal\u0131. A\xE7\u0131l\u0131\u015F saatlerinde, \xF6\u011Fle
      molas\u0131 d\u0131\u015F\u0131nda gel."
    m_Metadata:
      m_Items: []
