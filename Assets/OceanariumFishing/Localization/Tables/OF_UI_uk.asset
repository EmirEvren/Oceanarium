  m_TableData:
  - m_Id: 11652202496
    m_Localized: 'OCEANARIUM

      FISHING'
    m_Metadata:
      m_Items: []
  - m_Id: 11706728448
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u043E\u0441\u0442\u0440\u0456\u0432.
      \u0417\u0430\u0442\u0438\u0448\u043D\u0438\u0439 \u043A\u0443\u0442\u043E\u0447\u043E\u043A,
      \u044F\u043A\u0438\u0439 \u043C\u043E\u0436\u043D\u0430 \u043E\u0431\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922752
    m_Localized: "\u0414\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0432\u0430\u0442\u0438
      \u043E\u0441\u0442\u0440\u0456\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922753
    m_Localized: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F
      \u0442\u0430 \u043C\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922755
    m_Localized: "\u0420\u0406\u0414\u041D\u0418\u0419 \u0420\u0418\u0424"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922759
    m_Localized: "\u0417\u0430\u043A\u0440\u0438\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922760
    m_Localized: "\u0414\u043E \u0433\u043E\u043B\u043E\u0432\u043D\u043E\u0433\u043E
      \u043C\u0435\u043D\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922761
    m_Localized: "\u0427\u0443\u0442\u043B\u0438\u0432\u0456\u0441\u0442\u044C \u043A\u0430\u043C\u0435\u0440\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922762
    m_Localized: "\u041C\u043E\u0432\u0430 \u0437\u043C\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F
      \u043E\u0434\u0440\u0430\u0437\u0443, \u0430 \u0432\u0430\u0448 \u0432\u0438\u0431\u0456\u0440
      \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044C\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922763
    m_Localized: "\u0417\u2019\u042F\u0412\u0418\u0422\u042C\u0421\u042F \u041F\u0406\u0417\u041D\u0406\u0428\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922764
    m_Localized: "\u0426\u044E \u0441\u0446\u0435\u043D\u0443 \u043F\u0440\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043E
      \u0434\u043B\u044F \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E
      \u0435\u0442\u0430\u043F\u0443. \u0406\u0433\u0440\u043E\u0432\u0438\u0445
      \u043C\u043E\u0436\u043B\u0438\u0432\u043E\u0441\u0442\u0435\u0439 \u0442\u0443\u0442
      \u043F\u043E\u043A\u0438 \u043D\u0435\u043C\u0430\u0454."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922765
    m_Localized: "[E] \u041E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0445\u0430\u0442\u0438\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922766
    m_Localized: "[E] \u041E\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0441\u043A\u0440\u0438\u043D\u044E
      \u0437 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922767
    m_Localized: "[E] \u0412\u0437\u044F\u0442\u0438 \u043F\u043E\u0447\u0430\u0442\u043A\u043E\u0432\u0443
      \u0432\u0443\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922768
    m_Localized: "[E] \u0417\u043D\u0430\u0439\u0442\u0438 \u0430\u043A\u0432\u0430\u0440\u0456\u0443\u043C\u043D\u0438\u0439
      \u0441\u0430\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 11710922769
    m_Localized: "\u0412\u0430\u0448\u0430 \u0445\u0430\u0442\u0438\u043D\u0430 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044F
      \u0440\u0438\u0444\u0443. \u0406\u043D\u0442\u0435\u0440\u2019\u0454\u0440
      \u0437\u2019\u044F\u0432\u0438\u0442\u044C\u0441\u044F \u043D\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443
      \u0435\u0442\u0430\u043F\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922770
    m_Localized: "\u0421\u043F\u0456\u043B\u044C\u043D\u0430 \u0441\u043A\u0440\u0438\u043D\u044F
      \u0437 \u043F\u0440\u0438\u043F\u0430\u0441\u0430\u043C\u0438. \u0406\u043D\u0432\u0435\u043D\u0442\u0430\u0440
      \u0456 \u043F\u043E\u0441\u0442\u0456\u0439\u043D\u0435 \u0441\u0445\u043E\u0432\u0438\u0449\u0435
      \u0437\u2019\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F \u043F\u0456\u0437\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922772
    m_Localized: "\u0423 \u0432\u0430\u0441 \u0443\u0436\u0435 \u0454 \u0432\u0443\u0434\u043A\u0430.
      \u0426\u0456 \u0437\u0430\u043B\u0438\u0448\u0435\u043D\u043E \u0434\u043B\u044F
      \u0432\u0430\u0448\u043E\u0457 \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0457
      \u043A\u043E\u043C\u0430\u043D\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 11710922773
    m_Localized: "\u041C\u0456\u0441\u0446\u0435 \u0434\u043B\u044F \u043C\u0430\u0439\u0431\u0443\u0442\u043D\u044C\u043E\u0433\u043E
      \u0430\u043A\u0432\u0430\u0440\u0456\u0443\u043C\u043D\u043E\u0433\u043E \u0441\u0430\u0434\u0443.
      \u0411\u0443\u0434\u0456\u0432\u043D\u0438\u0446\u0442\u0432\u043E \u0437\u2019\u044F\u0432\u0438\u0442\u044C\u0441\u044F
      \u043D\u0430 \u043D\u0430\u0441\u0442\u0443\u043F\u043D\u043E\u043C\u0443 \u0435\u0442\u0430\u043F\u0456."
    m_Metadata:
      m_Items: []
